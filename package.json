{
  "name": "drug-hansch-space",
  "version": "0.1.0",
  "private": true,
  "description": "Test and tooling dependencies only. The published site (site/) has no build step and ships no node modules.",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 4173 --directory site",
    "test": "playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "check": "node tools/check-imports.mjs && python3 -I tools/check_site.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@iwer/sem": "2.5.0",
    "@playwright/test": "1.56.1",
    "iwer": "2.5.0"
  }
}
