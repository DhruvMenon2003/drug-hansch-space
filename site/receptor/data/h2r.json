er TM7 are all intracellular, as this file's own COMPND records name them.","markers_angstrom":{"C":43.51,"H":64.71,"L":78.2,"post-TM7 (H8 and the C terminus) of the receptor itself":14.44}},"membrane_normal_own_frame":[0.5254,0.2044,-0.826]},"active":{"pdb_id":"8YN3","title":"CRYO-EM STRUCTURE OF HISTAMINE H2 RECEPTOR IN COMPLEX WITH HISTAMINE AND MINIGS","method":"ELECTRON MICROSCOPY","resolution_angstrom":2.56,"deposition_date":"2024-03-10","header_classification":"SIGNALING PROTEIN","chain_used":"R","chains_discarded":"A, B, C, N (miniGs heterotrimer and nanobody Nb35)","n_ca":280,"residue_range":[14,302],"ligand":{"het":"HSM","name":"HISTAMINE","ccd_name":"HISTAMINE","formula":"C5 H9 N3","ccd_formula":"C5 H9 N3","ccd_formal_charge":"0","n_atoms":8,"n_bonds":8,"hydrogens_in_deposit":0,"bonds_from":"RCSB chemical component dictionary https://files.rcsb.org/ligands/download/HSM.cif","bonds_dropped_to_unmodelled_atoms":9,"conect_agrees":true,"chain":"R","residue":"701"},"download_url":"https://files.rcsb.org/download/8YN3.pdb","ligand_dictionary_url":"https://files.rcsb.org/ligands/download/HSM.cif","database_references":["DBREF: residues 309-483 are 8YN3, not P25021"],"non_primary_residue_numbers":[[309,483]],"tm_helices":{"TM1":{"start":17,"end":46,"n_ca":30,"span_along_normal_angstrom":36.66,"tilt_from_normal_deg":33.79},"TM2":{"start":51,"end":81,"n_ca":31,"span_along_normal_angstrom":40.97,"tilt_from_normal_deg":21.17},"TM3":{"start":90,"end":121,"n_ca":32,"span_along_normal_angstrom":40.85,"tilt_from_normal_deg":28.47},"TM4":{"start":127,"end":154,"n_ca":28,"span_along_normal_angstrom":39.74,"tilt_from_normal_deg":1.33},"TM5":{"start":180,"end":218,"n_ca":39,"span_along_normal_angstrom":50.15,"tilt_from_normal_deg":23.39},"TM6":{"start":230,"end":260,"n_ca":31,"span_along_normal_angstrom":39.63,"tilt_from_normal_deg":23.07},"TM7":{"start":266,"end":288,"n_ca":23,"span_along_normal_angstrom":31.45,"tilt_from_normal_deg":21.22}},"helical_runs_rejected":[{"start